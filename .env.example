# Environment variables for Leave Management System
# Copy this file to .env and configure as needed

# Database Configuration
DB_NAME=postgres
DB_USERNAME=postgres
DB_PASSWORD=mysecretpassword

# Frontend Configuration
# This is the public URL the end users will access the site from
# Update this with your actual domain when deploying
FRONTEND_URL=http://localhost

# Backend Configuration
# This is the public API URL that the frontend will query from the browser.
# Keep as localhost:8080 for testing locally. Update with actual IP/domain in production.
VITE_API_URL=http://localhost:8080/api
